DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vaultq
DB_USER=postgres
DB_PASS=password

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=vaultq
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

VOYAGE_API_KEY=
EMBED_PROVIDER=atlas
EMBED_BASE_URL=https://ai.mongodb.com/v1
EMBED_MODEL=voyage-context-3
EMBED_API_KEY=
EMBEDDING_DIM=1024
ENABLE_CONTEXTUAL_EMBEDDINGS=true

ENABLE_SPARSE_RETRIEVAL=true
SPARSE_BACKEND=postgres
SPARSE_VECTOR_NAME=sparse
QDRANT_SPARSE_MODEL=qdrant/bm25

ENABLE_RERANKER=true
RERANK_BASE_URL=https://ai.mongodb.com/v1
RERANKER_MODEL=rerank-2.5
RERANK_API_KEY=
RERANK_CANDIDATES=25
NEIGHBOR_WINDOW_SIZE=1

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_API_KEY=
LLM_SITE_URL=http://localhost
LLM_APP_NAME=VaultQ
LLM_RETRIES=4
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=900
LLM_TPM_LIMIT=15000

HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=6

CONTEXTUAL_WINDOW_TOKENS=28000
CONTEXTUAL_WINDOW_MAX_CHUNKS=96
CONTEXTUAL_REQUEST_MAX_GROUPS=8
CONTEXTUAL_REQUEST_MAX_DOCUMENTS=384
CONTEXTUAL_REQUEST_MAX_TOKENS=100000
QDRANT_MAX_UPSERT_BYTES=20000000
QDRANT_MAX_POINTS_PER_UPSERT=400

CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=360
CHUNK_TARGET_TOKENS=240
CHUNK_OVERLAP_FRAC=0.12

MCP_HOST=127.0.0.1
MCP_PORT=7070
