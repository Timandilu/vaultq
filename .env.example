DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vaultq
DB_USER=postgres
DB_PASS=password

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=vaultq
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

VOYAGE_API_KEY=
VQ_EMBED_ENV_FILE=
EMBED_PROVIDER=atlas
EMBED_BASE_URL=https://ai.mongodb.com/v1
EMBED_MODEL=voyage-context-3
EMBED_API_KEY=
EMBEDDING_DIM=1024
ENABLE_CONTEXTUAL_EMBEDDINGS=true

ENABLE_SPARSE_RETRIEVAL=true
SPARSE_BACKEND=postgres
SPARSE_VECTOR_NAME=sparse
QDRANT_SPARSE_MODEL=qdrant/bm25

ENABLE_RERANKER=true
RERANK_BASE_URL=https://ai.mongodb.com/v1
RERANKER_MODEL=rerank-2.5
RERANK_API_KEY=
RERANK_CANDIDATES=25
NEIGHBOR_WINDOW_SIZE=1
ENABLE_GRAPH_SIGNALS=true
GRAPH_SIGNALS_TOP_K=20
GRAPH_SIGNAL_FLOOR_RATIO=0
RESULT_MAX_PER_DOC=2

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_API_KEY=
LLM_SITE_URL=http://localhost
LLM_APP_NAME=VaultQ
LLM_RETRIES=4
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=900
LLM_TPM_LIMIT=15000

HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=6

CONTEXTUAL_WINDOW_TOKENS=12000
CONTEXTUAL_WINDOW_MAX_CHUNKS=32
CONTEXTUAL_TEXT_MAX_TOKENS=6000
CONTEXTUAL_REQUEST_MAX_GROUPS=4
CONTEXTUAL_REQUEST_MAX_DOCUMENTS=384
CONTEXTUAL_REQUEST_MAX_TOKENS=40000
QDRANT_MAX_UPSERT_BYTES=20000000
QDRANT_MAX_POINTS_PER_UPSERT=400

CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=360
CHUNK_TARGET_TOKENS=240
CHUNK_OVERLAP_FRAC=0.12

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=7073

VQ_SELF_MAINTAIN_COLLECTION=
VQ_SELF_MAINTAIN_INTERVAL_SECONDS=0
VQ_SELF_MAINTAIN_INITIAL_DELAY_SECONDS=60
VQ_SELF_MAINTAIN_MAX_ACTIONS=20
VQ_SELF_MAINTAIN_STATE_FILE=

# Optional low-impact background retrieval upkeep.
# Intended for MCP/runtime use: it starts from a path-only filesystem baseline,
# does not force a full startup index, performs path-only new-file discovery
# every 10 minutes, refreshes changed/deleted-file chunks at most daily, and
# writes DB-backed worker state readable through `vq background status --json`.
VQ_BACKGROUND_INDEX_COLLECTION=
VQ_BACKGROUND_INDEX_ENABLED=false
VQ_BACKGROUND_INDEX_POLL_SECONDS=300
VQ_BACKGROUND_INDEX_INITIAL_DELAY_SECONDS=60
VQ_BACKGROUND_NEW_FILE_DELAY_SECONDS=600
VQ_BACKGROUND_CHANGED_INDEX_SECONDS=86400
VQ_BACKGROUND_PENDING_EMBED_SECONDS=300
VQ_BACKGROUND_EMBED_LIMIT=100
VQ_BACKGROUND_MAX_EMBED_BATCHES=1
