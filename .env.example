DB_HOST=127.0.0.1
DB_PORT=5440
DB_NAME=postgres
DB_USER=postgres
DB_PASS=password

QDRANT_URL=http://127.0.0.1:6338
QDRANT_COLLECTION=vaultq

EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-large
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=3072

OPENROUTER_API_KEY=
KNOWLEDGE_MODEL=google/gemma-4-31b-it:free
KNOWLEDGE_TPM_LIMIT=15000
KNOWLEDGE_TIMEOUT=120
KNOWLEDGE_MAX_OUTPUT_TOKENS=900
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=VaultQ

ENABLE_LATE_INTERACTION=true
LATE_INTERACTION_MODEL=colbert-ir/colbertv2.0
LATE_INTERACTION_CANDIDATES=60
LATE_VECTOR_NAME=late

ENABLE_RERANKER=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RERANK_CANDIDATES=25
NEIGHBOR_WINDOW_SIZE=1

CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=320
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_FRAC=0.12
